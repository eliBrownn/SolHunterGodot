minimum = 5
maximum = 10

[sub_resource type="Resource" id="cinderkin"]
script = ExtResource("2")
class_id = "cinderkin"
description = "Consecutive attacking turns add this much damage bonus per turn, up to 15%. A turn without attacking resets it."
display_name = "Kindling"
minimum = 1
maximum = 5

[sub_resource type="Resource" id="tideborn"]
